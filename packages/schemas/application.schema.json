{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/application.schema.json",
  "title": "Application",
  "description": "The root application representation containing technologies, services, dependencies, and architecture.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the application."
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the application."
    },
    "repository_url": {
      "type": "string",
      "description": "URL to the application's source repository."
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string" },
          "source": { "type": "string" },
          "reasoning": { "type": "string" }
        },
        "required": ["name", "confidence", "evidence"]
      },
      "description": "Technologies detected at the application level."
    },
    "services": {
      "type": "array",
      "items": { "$ref": "service.schema.json" },
      "description": "Services comprising the application."
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "dependency.schema.json" },
      "description": "All dependencies detected across the application."
    },
    "apis": {
      "type": "array",
      "items": { "$ref": "api.schema.json" },
      "description": "A flat list of all explicitly discovered HTTP/API endpoints."
    },
    "architecture": {
      "$ref": "architecture.schema.json",
      "description": "The architecture graph representation."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Arbitrary metadata about the application (e.g., ingestion source)."
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "risk.schema.json" },
      "description": "Deterministic risk findings."
    },
    "test_candidates": {
      "type": "array",
      "items": { "$ref": "test-candidate.schema.json" },
      "description": "Deterministic test candidates."
    },
    "experiments": {
      "type": "array",
      "items": { "$ref": "experiment.schema.json" },
      "description": "Deterministic declarative experiment specifications."
    },
    "safety_decisions": {
      "type": "array",
      "items": { "$ref": "safety-decision.schema.json" },
      "description": "Deterministic safety and policy decisions."
    },
    "experiment_runs": {
      "type": "array",
      "items": { "$ref": "experiment-run.schema.json" },
      "description": "Execution lifecycle representations."
    }
  },
  "required": ["id", "name", "technologies", "services", "dependencies", "architecture"]
}
