{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/recommendation.schema.json",
  "title": "Actionable Recommendation",
  "description": "Actionable resilience recommendation backed by empirical evidence for CHAOS-INTEL Phase 4.",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "resilience",
        "capacity",
        "timeout_tuning",
        "circuit_breaker",
        "retry_policy",
        "redundancy",
        "configuration",
        "database_tuning"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_service": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_risk_reduction": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "recommendation_id",
    "category",
    "priority",
    "title",
    "description",
    "target_service",
    "confidence"
  ]
}