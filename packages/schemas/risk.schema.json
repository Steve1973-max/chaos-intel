{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/risk.schema.json",
  "title": "Risk Finding",
  "description": "A deterministic risk finding detected in the application architecture.",
  "type": "object",
  "properties": {
    "risk_id": { "type": "string" },
    "application_id": { "type": "string" },
    "category": { "type": "string", "enum": ["architecture", "dependency", "availability", "api", "infrastructure", "configuration"] },
    "risk_type": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "type": { "type": "string" },
          "detail": { "type": "string" }
        },
        "required": ["source", "type", "detail"]
      }
    },
    "indicators": {
      "type": "array",
      "items": { "type": "object" }
    },
    "metadata": { "type": "object" }
  },
  "required": [
    "risk_id", "application_id", "category", "risk_type", "severity", 
    "title", "description", "target_type", "target_id", "confidence", "evidence"
  ]
}
