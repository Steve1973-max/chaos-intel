{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/architecture.schema.json",
  "title": "Architecture Graph",
  "description": "Graph representation of the application for UI visualization and risk analysis.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": { "type": "string" },
          "node_type": { "type": "string" },
          "name": { "type": "string" },
          "service_id": { "type": ["string", "null"] },
          "technology_references": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string" },
                "type": { "type": "string" },
                "detail": { "type": "string" }
              },
              "required": ["source", "type"]
            }
          }
        },
        "required": ["node_id", "node_type", "name", "confidence", "evidence"]
      },
      "description": "Entities in the architecture (services, databases, third-party APIs)."
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "edge_id": { "type": "string" },
          "source_node_id": { "type": "string" },
          "target_node_id": { "type": "string" },
          "edge_type": { "type": "string" },
          "protocol": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string" },
                "type": { "type": "string" },
                "detail": { "type": "string" }
              },
              "required": ["source", "type"]
            }
          },
          "metadata": { "type": "object" }
        },
        "required": ["edge_id", "source_node_id", "target_node_id", "edge_type", "confidence", "evidence"]
      },
      "description": "Relationships and data flows between nodes."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["nodes", "edges"]
}
