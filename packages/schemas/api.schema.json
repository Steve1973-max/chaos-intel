{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/api.schema.json",
  "title": "API",
  "description": "An explicitly discovered HTTP/API endpoint.",
  "type": "object",
  "properties": {
    "api_id": {
      "type": "string",
      "description": "Unique deterministic identifier for the API."
    },
    "service_id": {
      "type": ["string", "null"],
      "description": "ID of the service that exposes this API. Null if ambiguous."
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"],
      "description": "HTTP method."
    },
    "path": {
      "type": "string",
      "description": "Normalized route path."
    },
    "protocol": {
      "type": ["string", "null"],
      "description": "Protocol (e.g., http, https, grpc, websocket)."
    },
    "framework": {
      "type": ["string", "null"],
      "description": "The framework that exposes this API."
    },
    "source": {
      "type": ["string", "null"],
      "description": "The file or location where this API was found."
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "location": { "type": "string", "enum": ["path", "query", "header", "cookie", "unknown"] }
        },
        "required": ["name", "location"]
      }
    },
    "request_body": {
      "type": ["object", "null"],
      "description": "Schema or reference to the request body definition."
    },
    "response_information": {
      "type": ["object", "null"],
      "description": "Schema or reference to the response definitions."
    },
    "auth_required": {
      "type": ["boolean", "null"],
      "description": "Whether this endpoint strictly requires authentication. Null if unknown."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score of the API discovery."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "type": { "type": "string" },
          "detail": { "type": "string" }
        },
        "required": ["source", "type"]
      },
      "description": "Evidence supporting the API detection."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["api_id", "method", "path", "confidence", "evidence"]
}
