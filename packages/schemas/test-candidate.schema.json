{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/test-candidate.schema.json",
  "title": "Test Candidate",
  "description": "A deterministically generated hypothesis validation plan for application resilience.",
  "type": "object",
  "properties": {
    "candidate_id": { "type": "string" },
    "application_id": { "type": "string" },
    "target_type": { "type": "string" },
    "target_id": { "type": "string" },
    "test_type": { "type": "string", "enum": ["availability", "latency", "dependency_resilience", "api_resilience", "resource_exhaustion", "failover", "degradation", "workflow_resilience"] },
    "title": { "type": "string" },
    "hypothesis": { "type": "string" },
    "reason": { "type": "string" },
    "expected_failure_mode": { "type": "string" },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "type": { "type": "string" },
          "detail": { "type": "string" }
        },
        "required": ["source", "type", "detail"]
      }
    },
    "related_risk_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_observations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": { "type": "object" }
  },
  "required": [
    "candidate_id", "application_id", "target_type", "target_id", "test_type", 
    "title", "hypothesis", "reason", "expected_failure_mode", "priority", 
    "confidence", "prerequisites", "evidence"
  ]
}
