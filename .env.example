# CHAOS-INTEL Platform Environment Variables Example

# Environment Mode
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Persistence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chaos_intel
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/chaos_intel

# Redis Queue & Caching
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-32-chars
ADMIN_API_KEY=admin-key-supersecret
OPERATOR_API_KEY=operator-key-secret
VIEWER_API_KEY=viewer-key-public

# Storage & Uploads
UPLOAD_DIR=staging_uploads
MAX_UPLOAD_SIZE_MB=50

# Platform Invariants
ENABLE_LIVE_CHAOS_EXECUTION=false
REQUIRE_EXPLICIT_APPROVAL=true
