{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chaos-intel.local/schemas/test-case.schema.json",
  "title": "Test Case",
  "description": "A structured, explainable, and evidence-backed resilience test case generated by the Testing Agents service.",
  "type": "object",
  "properties": {
    "test_case_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "application_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "target_type": { "type": "string", "minLength": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "target_name": { "type": "string", "minLength": 1 },
    "test_type": {
      "type": "string",
      "enum": [
        "availability",
        "latency",
        "dependency_resilience",
        "api_resilience",
        "resource_exhaustion",
        "failover",
        "degradation",
        "workflow_resilience"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "expected_failure_mode": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "requires_review"]
    },
    "mode": {
      "type": "string",
      "enum": ["plan_only"]
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "requires_safety_decision": {
      "type": "boolean",
      "const": true
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "priority_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rank": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "priority_breakdown": {
      "type": "object",
      "properties": {
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "priority_band": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "severity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "dependency_criticality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "factors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "total_score",
        "priority_band",
        "risk_score",
        "severity_score",
        "dependency_criticality_score",
        "confidence_score",
        "explanation",
        "factors"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "step_number": { "type": "integer", "minimum": 1 },
          "phase": {
            "type": "string",
            "enum": ["steady_state_check", "stimulus_plan", "observation", "recovery_verification"]
          },
          "action": { "type": "string", "minLength": 1 },
          "expected_observation": { "type": "string", "minLength": 1 }
        },
        "required": ["step_number", "phase", "action", "expected_observation"]
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "required_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_risk_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_experiment_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        },
        "required": ["source", "type", "detail"]
      }
    },
    "evidence_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "generation_source": {
      "type": "string",
      "enum": ["deterministic_candidate", "coverage_gap_synthesis", "ai_suggestion"]
    },
    "provider_id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  },
  "required": [
    "test_case_id",
    "schema_version",
    "application_id",
    "candidate_id",
    "target_type",
    "target_id",
    "target_name",
    "test_type",
    "title",
    "hypothesis",
    "reason",
    "expected_failure_mode",
    "status",
    "mode",
    "execution_authorized",
    "requires_safety_decision",
    "priority",
    "priority_score",
    "priority_breakdown",
    "confidence",
    "preconditions",
    "test_steps",
    "assertions",
    "required_capabilities",
    "related_risk_ids",
    "related_experiment_ids",
    "evidence",
    "evidence_reasoning",
    "generation_source",
    "provider_id"
  ]
}

